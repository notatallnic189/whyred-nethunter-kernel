diff --git a/Makefile b/Makefile
index 63ce43e..1a3acc8 100755
--- a/Makefile
+++ b/Makefile
@@ -19,6 +19,8 @@ EXTRA_CFLAGS += -Wno-unknown-pragmas
 EXTRA_CFLAGS += -Wno-address
 EXTRA_CFLAGS += -Wno-vla -g
 
+# NetHunter whyred: kernel backported 4.7+ cfg80211 symbols
+EXTRA_CFLAGS += -DCONFIG_KERNEL_HAS_NEW_BANDS
 EXTRA_CFLAGS += -I$(src)/include -I$(srctree)/$(src)/include
 EXTRA_CFLAGS += -I$(src)/hal/phydm -I$(srctree)/$(src)/hal/phydm
 EXTRA_LDFLAGS += --strip-debug -O3
